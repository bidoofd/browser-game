{
   "name": "speedrun-browser-game",
   "author": "Ariel Gerstein <ariel.gers@gmail.com>",
   "license": "AGPL-3.0-or-later",
   "private": true,
   "workspaces": [
      "packages/*"
   ],
   "scripts": {
      "startdev": "npm run build:client && npm run start:server",
      "build:client": "npm run delete && lerna run build --scope=@speedrun-browser-game/client",
      "start:server": "lerna run build --scope=@speedrun-browser-game/common && lerna run start --scope=@speedrun-browser-game/server",
      "delete": "rm -rf node_modules/ && rm -rf packages/client/.parcel-cache && rm -rf packages/client/dist && rm -rf packages/common/build && rm -rf packages/common/node_modules && rm -rf packages/server/build && rm -rf packages/server/node_modules && npm i",
      "start": "ts-node packages/server/src/index.ts",
      "dev": "nodemon -w *.ts -w packages/server/.env packages/server/src/index.ts",
      "typeorm": "typeorm-ts-node-commonjs",
      "test": "jest"
   },
   "devDependencies": {
      "@types/morgan": "^1.9.9",
      "@types/node": "^16.18.119",
      "dotenv": "^16.4.5",
      "express-validator": "^7.2.0",
      "fs": "^0.0.1-security",
      "jest": "^29.7.0",
      "lerna": "^6.6.1",
      "nodemon": "^3.1.7",
      "reflect-metadata": "^0.2.2",
      "supertest": "^7.0.0",
      "ts-node": "10.9.1",
      "typescript": "4.5.2"
   },
   "version": "0.0.1",
   "engines": {
      "node": "18.x"
   },
   "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
   "dependencies": {
      "@socket.io/postgres-adapter": "^0.4.0",
      "body-parser": "^1.19.1",
      "class-transformer": "^0.5.1",
      "express": "^4.17.2",
      "morgan": "^1.10.0",
      "pg": "^8.13.1",
      "typeorm": "0.3.20"
   }
}
